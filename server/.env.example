# ============================================
# Classtifier Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# ─── Clerk Authentication ───────────────────
# Get these from https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_SECRET_KEY"

# ─── Firebase / Firestore ───────────────────
# Option A: Service account file path (recommended for local dev)
# Download from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Option B: Individual env vars (recommended for deployment)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ─── Server Config ──────────────────────────
PORT=4000
NODE_ENV="development"

# ─── Frontend URL (for CORS) ────────────────
FRONTEND_URL="http://localhost:3000"
